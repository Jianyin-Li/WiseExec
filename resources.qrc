<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <file>resources/app_icon.ico</file>
        <file>resources/favicon.ico</file>
        <file>resources/style.qss</file>
    </qresource>
    <qresource prefix="/i18n">
        <file alias="QuickStart_zh_CN.qm">resources/QuickStart_zh_CN.qm</file>
        <file alias="QuickStart_en.qm">resources/QuickStart_en.qm</file>
    </qresource>
</RCC>
