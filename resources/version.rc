#include <winver.h>

// Version resource. Without it the file's Properties → Details tab is
// empty, and tools that validate a binary (SmartScreen included) have no
// publisher metadata to check. Keep the values in step with the VERSION file
// and CMakeLists.txt's PROJECT_VERSION.
VS_VERSION_INFO VERSIONINFO
    FILEVERSION     2,0,0,0
    PRODUCTVERSION  2,0,0,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS       VS_FF_DEBUG
#else
    FILEFLAGS       0x0L
#endif
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0x0409 = en-US, 0x04B0 = Unicode
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "WiseExec"
            VALUE "FileDescription",  "WiseExec application launcher"
            VALUE "FileVersion",      "2.0.0"
            VALUE "InternalName",     "WiseExec"
            VALUE "LegalCopyright",   "Copyright (C) 2024 WiseExec"
            VALUE "OriginalFilename", "WiseExec.exe"
            VALUE "ProductName",      "WiseExec"
            VALUE "ProductVersion",   "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
